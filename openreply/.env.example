# Shared across Web App (Vercel) and Worker (Railway/Render)
NEXTAUTH_URL=https://your-openreply-app.vercel.app
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
CRON_SECRET=replace-with-openssl-rand-base64-32
# Must be identical 64-hex-char key on both Web App and Worker
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Databases (use internal URLs on Railway worker; public URLs on Vercel)
DATABASE_URL=postgresql://user:password@host:5432/openreply
REDIS_URL=redis://default:password@host:6379

# Magic-link login email (use Resend OR EMAIL_SERVER for Zoho SMTP)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=noreply@steadydays.store
# EMAIL_SERVER=smtps://support%40steadydays.store:APP_PASSWORD@smtp.zoho.com:465
ALLOWED_EMAILS=swaltnuscord@gmail.com,support@steadydays.store

# Direct Meta Connection only (leave unset if using Zernio)
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=replace-with-random-verify-token

# Optional polling reconciler tuning (defaults shown)
COMMENT_POLL_INTERVAL_MS=300000
COMMENT_POLL_MAX_PER_SWEEP=30
COMMENT_POLL_LOOKBACK_HOURS=72
